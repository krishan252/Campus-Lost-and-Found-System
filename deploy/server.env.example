# Copy to deploy/server.env on your hosting server. NEVER COMMIT actual file.
# Percent-encode any special characters in the DATABASE_URL password.
DATABASE_URL=postgresql://unitrace:replace-with-the-same-password@db:5432/unitrace?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=https://unitrace.example.edu
ALLOWED_EMAIL_DOMAINS=engug.ruh.ac.lk,ruh.ac.lk
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=UniTrace <noreply@unitrace.example.edu>
