generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                     String @id @default(uuid())
  fullName               String
  email                  String @unique
  passwordHash           String
  role                   Role @default(USER)
  emailVerifiedAt        DateTime?
  sessionVersion         Int @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  reports                Report[] @relation("Reporter")
  claims                 Claim[] @relation("Claimant")
  moderationReviews      ModerationReview[] @relation("Reviewer")
  verificationTokens     EmailVerificationToken[]
  auditEvents            AuditEvent[]
  @@index([role])
}

model EmailVerificationToken {
  id            String @id @default(uuid())
  userId        String
  tokenHash     String @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model ItemCategory {
  id      Int @id @default(autoincrement())
  name    String @unique
  reports Report[]
}

model CampusLocation {
  id      Int @id @default(autoincrement())
  name    String @unique
  reports Report[]
}

model Report {
  id             String @id @default(uuid())
  reporterId     String
  reportType     ReportType
  categoryId     Int
  locationId     Int
  title          String
  publicDescription String @db.Text
  eventDate      DateTime @db.Date
  status         ReportStatus @default(PENDING_REVIEW)
  lastReviewReason String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reporter       User @relation("Reporter", fields: [reporterId], references: [id])
  category       ItemCategory @relation(fields: [categoryId], references: [id])
  location       CampusLocation @relation(fields: [locationId], references: [id])
  privateDetails PrivateReportDetails?
  images         ReportImage[]
  claims         Claim[]
  reviews        ModerationReview[]
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model PrivateReportDetails {
  reportId          String @id
  secretAttributes  String? @db.Text
  storageLocation   String? @db.Text
  finderContact     String? @db.Text
  report            Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportImage {
  id          String @id @default(uuid())
  reportId    String
  storedName  String @unique
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime @default(now())
  report      Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  @@index([reportId])
}

model ModerationReview {
  id            String @id @default(uuid())
  reportId      String
  reviewerId    String
  decision      String
  reason        String? @db.Text
  reviewedAt    DateTime @default(now())
  report        Report @relation(fields: [reportId], references: [id])
  reviewer      User @relation("Reviewer", fields: [reviewerId], references: [id])
  @@index([reportId, reviewedAt])
}

model AuditEvent {
  id            String @id @default(uuid())
  actorId       String
  action        String
  entityType    String
  entityId      String
  occurredAt    DateTime @default(now())
  metadata      Json?
  actor         User @relation(fields: [actorId], references: [id])
  @@index([entityType, entityId])
}

// Ownership claims for approved FOUND reports. Claim evidence stays private.
// CLFR-64 will add race-safe uniqueness for active claims.
model Claim {
  id                String      @id @default(uuid())
  reportId          String
  claimantId        String
  ownershipEvidence String      @db.Text
  status            ClaimStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  report            Report      @relation(fields: [reportId], references: [id], onDelete: Restrict)
  claimant          User        @relation("Claimant", fields: [claimantId], references: [id], onDelete: Restrict)

  @@index([reportId, status])
  @@index([claimantId, createdAt])
}
