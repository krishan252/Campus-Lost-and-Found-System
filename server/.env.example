# COPY THIS TO .env AND CHANGE SECRETS BEFORE RUNNING
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://clfr:clfr_local_password@localhost:5433/campus_lost_found?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=engug.ruh.ac.lk,ruh.ac.lk
# Local development: verification URL printed in backend terminal.
# Production registration requires SMTP settings below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Campus Lost and Found <noreply@example.org>
# Optional local demo admin - never use shared passwords in production
DEMO_ADMIN_EMAIL=admin@engug.ruh.ac.lk
DEMO_ADMIN_PASSWORD=
