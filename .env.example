POSTGRES_USER=clfr
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=campus_lost_found
POSTGRES_PORT=5433
API_PORT=4000
NODE_ENV=development

# Used by Docker containers. For local server development, use localhost:5433 instead of db:5432.
DATABASE_URL=postgresql://clfr:change-me-in-local-env@db:5432/campus_lost_found?schema=public
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173

# Optional: set both values to create/update the seeded administrator account.
# ADMIN_EMAIL=admin@example.edu
# ADMIN_PASSWORD=use-a-new-random-password-of-12-or-more-characters
